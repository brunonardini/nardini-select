# Local example values only. Copy this file to .env. Never commit .env.
# Neon passwords and connection URLs stay out of Git.

WHATSAPP_NUMBER=5511999999999

# Docker superuser. Used by db:provision.
PROVISION_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres
# Creates nardini_dev and nardini_test. Leave unset when provisioning Neon.
PROVISION_CREATE_DATABASES=1

APP_MIGRATOR_PASSWORD=migrator
APP_RUNTIME_PASSWORD=runtime
AUDIT_MAINTAINER_PASSWORD=maintainer

# Runtime role, pooled in production (sslmode=verify-full on Neon).
DATABASE_URL=postgres://app_runtime:runtime@127.0.0.1:5432/nardini_dev
# Direct endpoint. Migrations and db:reset.
DATABASE_MIGRATION_URL=postgres://app_migrator:migrator@127.0.0.1:5432/nardini_dev
# Direct endpoint. Retention job (M5).
AUDIT_MAINTAINER_URL=postgres://audit_maintainer:maintainer@127.0.0.1:5432/nardini_dev
