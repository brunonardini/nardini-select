{
  "name": "nardini-select",
  "version": "0.0.0-development",
  "private": true,
  "engines": {
    "node": ">=26.13.1"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "knip": "knip",
    "format": "prettier --write ./app ./components ./lib ./db ./.storybook ./e2e",
    "format:check": "prettier --check ./app ./components ./lib ./db ./.storybook ./e2e",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:clean": "docker compose down --rmi all",
    "db:provision": "node --env-file-if-exists=.env --disable-warning=MODULE_TYPELESS_PACKAGE_JSON db/provision/apply.ts",
    "db:migrate": "node --env-file-if-exists=.env ./node_modules/node-pg-migrate/bin/node-pg-migrate.js up --config-file .node-pg-migraterc.json -d DATABASE_MIGRATION_URL",
    "db:seed": "node --env-file-if-exists=.env --disable-warning=MODULE_TYPELESS_PACKAGE_JSON db/seeds/index.ts",
    "db:reset": "node --env-file-if-exists=.env --disable-warning=MODULE_TYPELESS_PACKAGE_JSON db/provision/reset.ts && npm run db:migrate && npm run db:seed",
    "db:codegen": "node --env-file-if-exists=.env ./node_modules/kysely-codegen/dist/cli/bin.js",
    "db:lint": "squawk db/migrations/*.sql",
    "db:grants": "node --env-file-if-exists=.env --disable-warning=MODULE_TYPELESS_PACKAGE_JSON db/provision/grants-check.ts",
    "test": "vitest run --project=unit",
    "test:watch": "vitest --project=unit",
    "test:coverage": "vitest run --project=unit --coverage",
    "test:storybook": "vitest run --project=storybook",
    "test:e2e": "npm run build && playwright test",
    "prepare": "husky"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@sentry/nextjs": "^11.12.0",
    "kysely": "0.28.19",
    "next": "^16.4.6",
    "pg": "8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@faker-js/faker": "10.6.0",
    "@knip/mcp": "^0.0.38",
    "@playwright/test": "^1.65.1",
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/addon-mcp": "^10.6.7",
    "@storybook/addon-vitest": "^10.6.7",
    "@storybook/nextjs-vite": "^10.6.7",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/browser-playwright": "^5.1.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "eslint-plugin-storybook": "^10.6.7",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "knip": "^6.45.1",
    "kysely-codegen": "0.20.0",
    "node-pg-migrate": "9.0.0",
    "prettier": "3.10.1",
    "squawk-cli": "2.70.0",
    "storybook": "^10.6.7",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
