{
  "name": "nardini-select",
  "version": "0.0.0-development",
  "private": true,
  "engines": {
    "node": ">=26.13.1"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write ./app ./e2e",
    "format:check": "prettier --check ./app ./e2e",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && playwright test",
    "prepare": "husky"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "latest",
    "@fontsource-variable/manrope": "latest",
    "@sentry/nextjs": "^11.12.0",
    "next": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@playwright/test": "^1.65.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "prettier": "3.9.10",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
